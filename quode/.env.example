# Copiá este archivo a .env.local y completá con los datos de tu proyecto de Appwrite.
# Los encontrás en la consola de Appwrite: Overview (endpoint/project ID) y Databases (database/table ID).
# Ojo: el endpoint suele ser regional, ej. https://fra.cloud.appwrite.io/v1 (no siempre el genérico cloud.appwrite.io).

NEXT_PUBLIC_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
NEXT_PUBLIC_APPWRITE_TABLE_ID=
